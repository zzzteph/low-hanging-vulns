  "summaries": [
    {
      "id": 900754,
      "category": "team",
      "content": "# Description\nA stack-based buffer overflow vulnerability in the Nintendo Switch local wireless networking functionality may allow an attacker within wireless range to execute arbitrary code using return-oriented programming (ROP) through crafted network traffic.",
      "updated_at": "2026-09-02T06:15:17.577Z",
      "can_view?": true,
      "can_create?": false,
      "attachments": [],
      "user": {
        "id": 60412,
        "username": "tattsun",
        "name": "Ramen Chevalier",
        "bio": null,
        "cleared": false,
