  "summaries": [
    {
      "id": 928399,
      "category": "team",
      "content": "Mozilla's Bugzilla instance had two authentication implementations with inconsistent account status validation. The legacy REST API (rest.cgi) and web interface correctly refused disabled accounts, but the newer REST routes (/rest/search/*, /rest/component/*) authenticated API keys without checking if the account was still enabled.\n\nThe issue was fixed by adding proper account status validation to the REST API authentication flow.",
      "updated_at": "2026-10-26T10:47:56.399Z",
      "can_view?": true,
      "can_create?": false,
      "attachments": [],
      "user": {
